# Copy to .env.local for a local dev server. `npx sst deploy` sets these on the built site.
VITE_GRAPHQL_URL=https://xxxxxxxx.appsync-api.us-east-1.amazonaws.com/graphql
# Optional; derived from VITE_GRAPHQL_URL when omitted.
VITE_GRAPHQL_REALTIME_URL=wss://xxxxxxxx.appsync-realtime-api.us-east-1.amazonaws.com/graphql
VITE_GRAPHQL_API_KEY=da2-xxxxxxxxxxxxxxxxxxxxxxxxxx
